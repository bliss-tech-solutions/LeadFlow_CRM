NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/leadflow_crm
MONGO_DB_NAME=leadflow_crm
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
META_VERIFY_TOKEN=replace-with-a-unique-webhook-verification-token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
META_LEAD_FETCH_URL=https://graph.facebook.com
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRESIGN_EXPIRES=900

# LeadSync middleware webhook (header: x-leadsync-secret)
LEADSYNC_WEBHOOK_SECRET=

# Email (password reset links, daily digests). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LeadFlow CRM <no-reply@yourdomain.com>

# WhatsApp (QR-linked device). Requires an always-on, SINGLE API instance.
WA_ENABLED=true
# 32+ random characters. Encrypts stored WhatsApp session credentials. Never change it after go-live
# (changing it forces every business to scan the QR again).
WA_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
WA_DAILY_LIMIT=150
WA_MIN_GAP_MS=4000
WA_MAX_GAP_MS=9000
WA_DEFAULT_COUNTRY_CODE=91

# Minutes before an uncontacted NEW lead raises an SLA alert (businesses can override).
LEAD_SLA_MINUTES=15

# Mobile apps (LeadFlow Admin / LeadFlow Partner)
APP_MIN_VERSION_ADMIN=1.0.0
APP_MIN_VERSION_PARTNER=1.0.0
APP_LATEST_VERSION_ADMIN=1.0.0
APP_LATEST_VERSION_PARTNER=1.0.0
APP_MAINTENANCE=false
SUPPORT_EMAIL=support@yourdomain.com
STORE_URL_ANDROID_ADMIN=
STORE_URL_ANDROID_PARTNER=
STORE_URL_IOS_ADMIN=
STORE_URL_IOS_PARTNER=
# Only if "Enhanced push security" is enabled in your Expo account
EXPO_ACCESS_TOKEN=
