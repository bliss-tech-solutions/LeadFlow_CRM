# Backend API (no trailing slash). Android emulator → http://10.0.2.2:4000/api, device on Wi-Fi → http://<your-pc-ip>:4000/api
EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
# EAS project ids (from `npx eas-cli init`) — enable push tokens and OTA updates
EAS_PROJECT_ID_PARTNER=
EAS_PROJECT_ID_ADMIN=
